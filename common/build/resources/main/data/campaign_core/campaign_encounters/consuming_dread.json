{
  "id": "campaign_core:washed_ashore/consuming_dread",
  "boss_entity": "sculk_and_scavenge:consuming_dread",
  "anchor": "dark_forest",
  "activation_radius": 36,
  "reset_radius": 112,
  "one_shot": true,
  "required_stage": "REGIONAL_OBJECTIVES",
  "retry_delay_ticks": 12000,
