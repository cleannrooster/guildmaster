      { "mode": "modulo", "at": 45, "step": 20, "effect": "darken" },
      { "mode": "cross", "at": 70, "effect": "remove_prey", "message": "prey_missing", "guard": "prey_over_required" },
      { "mode": "cross", "at": 85, "effect": "kill_prey", "guard": "prey_over_required" }
    ],
    "on_full": { "message": "dread_manifest", "guard": "prey_at_least_required", "action": "begin_manifestation" }
  },
  "on_complete": {
    "handlers": ["complete_dread_quest", "regional_objectives_gate"]
  }
